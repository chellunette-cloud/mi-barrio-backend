{
  "name": "mi-barrio-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:contract": "vitest run tests/contract",
    "test:geo": "vitest run tests/geographic",
    "check:lines": "node scripts/check-line-limit.mjs",
    "verify:data": "node scripts/verify-data-hashes.mjs",
    "migrate": "tsx src/infrastructure/db/migrate.ts",
    "etl": "tsx src/infrastructure/etl/run.ts",
    "ci": "npm run lint && npm run typecheck && npm run check:lines && npm run verify:data && npm run test"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/pg": "^8.15.6",
    "@types/supertest": "^6.0.3",
    "eslint": "^9.39.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
